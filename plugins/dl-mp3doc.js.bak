import fetch from 'node-fetch'

let handler = async (m, { conn, text, usedPrefix, command }) => {
  if (!text) return m.reply(`❀ Ingresa lo que quieres buscar\n> Ejemplo:\n${usedPrefix + command} amnesia`)

  try {
    await m.react('🕒')
    const api = `${global.APIs.light.url}/search/yts?q=${encodeURIComponent(text)}`
    const res = await fetch(api)
    const json = await res.json()
    if (!json.status ||!json.result?.length) throw 'No se encontraron resultados'
    const data = json.result[0]

    await conn.sendMessage(m.chat, {
      image: { url: data.thumbnail },
      caption: `🎧 *YouTube Downloader*\n\n🧊 *Título:* ${data.title}\n👤 *Autor:* ${data.author}\n⏱️ *Duración:* ${data.duration}\n👁️ *Vistas:* ${data.views}\n🔗 *Link:* ${data.url}`
    }, { quoted: m })

    await m.react('📥')

    const api2 = `${global.APIs.light.url}/download/ytmp3?url=${encodeURIComponent(data.url)}`
    const res2 = await fetch(api2)
    const json2 = await res2.json()
    if (!json2.status ||!json2.data?.dl) throw 'Error al obtener el audio'

    const fileName = `${json2.data.title.replace(/[\\/:*?"<>|]/g, '')}.mp3`

    await conn.sendMessage(m.chat, {
      document: { url: json2.data.dl },
      mimetype: 'audio/mpeg',
      fileName,
      caption: `🫒 *${json2.data.title}*\n\nDescarga completa`
    }, { quoted: m })

    await m.react('✅')

  } catch (e) {
    m.reply(`✘ Error:\n${e.message || e}`)
  }
}

handler.help = ['ytmp3doc *<búsqueda>*']
handler.tags = ['download']
handler.command = ['ytmp3doc', 'mp3doc']
export default handler